# =============================================================================
# PETMATE BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and adjust variables to match your local or server MySQL.
# =============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MySQL Database Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example for default local MySQL:
DATABASE_URL="mysql://root:YOUR_LOCAL_MYSQL_PASSWORD@localhost:3306/petmate_db"

# JWT Secret for Admin Authentication (generate a secure random 32+ character string)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"

# Initial Admin Password for Database Seeding (change before running seed in production)
ADMIN_SEED_PASSWORD="choose_a_strong_admin_password_for_initial_seed"

# CORS Origin (comma-separated list of allowed frontend origins)
CLIENT_URL="http://localhost:5173"
